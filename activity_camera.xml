<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Pratinjau Kamera -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topProControls"
        app:layout_constraintBottom_toTopOf="@id/bottomProControls" />

    <!-- Baris Kontrol Atas (RAW, Info, Switch Camera, Settings) -->
    <LinearLayout
        android:id="@+id/topProControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:background="#99000000"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button android:id="@+id/btnRawToggle" android:layout_width="wrap_content" android:layout_height="32dp" android:text="RAW" android:textSize="10sp" android:layout_marginHorizontal="4dp"/>
        <Button android:id="@+id/btnOpenSettings" android:layout_width="wrap_content" android:layout_height="32dp" android:text="⚙️️" android:textSize="12sp" android:layout_marginHorizontal="4dp"/>
    </LinearLayout>

    <!-- Kontrol Bawah (Parameter Pro: EV, ISO, S, WB, MF & Tombol Shutter) -->
    <LinearLayout
        android:id="@+id/bottomProControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Baris Parameter Manual Pro (EV, ISO, S, WB, MF) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="8dp">

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <Button android:id="@+id/btnEv" android:layout_width="50dp" android:layout_height="36dp" android:text="EV" android:textSize="10sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#AAAAAA" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <Button android:id="@+id/btnIso" android:layout_width="50dp" android:layout_height="36dp" android:text="ISO" android:textSize="10sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#AAAAAA" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <Button android:id="@+id/btnShutter" android:layout_width="50dp" android:layout_height="36dp" android:text="S" android:textSize="10sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#AAAAAA" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <Button android:id="@+id/btnWb" android:layout_width="50dp" android:layout_height="36dp" android:text="WB" android:textSize="10sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#AAAAAA" android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <Button android:id="@+id/btnMf" android:layout_width="50dp" android:layout_height="36dp" android:text="MF" android:textSize="10sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#AAAAAA" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol Shutter Utama Mode Pro -->
        <Button
            android:id="@+id/btnCapturePro"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:text="SNAP"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:backgroundTint="@android:color/holo_red_dark" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




