<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Umum"
                android:textColor="#FFC107"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/switchShutterSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Suara rana"
                android:textColor="@android:color/white"
                android:paddingVertical="12dp" />

            <Switch
                android:id="@+id/switchLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lokasi"
                android:textColor="@android:color/white"
                android:paddingVertical="12dp" />

            <Switch
                android:id="@+id/switchMirror"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swafoto tampilan cermin"
                android:textColor="@android:color/white"
                android:paddingVertical="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto &amp; Video"
                android:textColor="#FFC107"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/switchWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tanda Air"
                android:textColor="@android:color/white"
                android:paddingVertical="12dp" />

            <Button
                android:id="@+id/btnResetDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pulihkan default"
                android:backgroundTint="#222222"
                android:textColor="#FFC107"
                android:layout_marginTop="32dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>



