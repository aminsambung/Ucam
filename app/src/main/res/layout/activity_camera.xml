    <!-- Baris Kontrol Atas (Flash, HDR, Macro, Ratio, RAW, Settings) -->
    <LinearLayout
        android:id="@+id/topProControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="#99000000"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol Flash (OFF / ON / AUTO) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlashToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="⚡ OFF"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- Tombol HDR (OFF / ON) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHdrToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="HDR: OFF"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- Tombol Macro (OFF / ON) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMacroToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="MACRO"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- Tombol Rasio (4:3 / 16:9) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRatioToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="4:3"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- Tombol RAW -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRawToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="RAW"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- Tombol Pengaturan (Settings) -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>
