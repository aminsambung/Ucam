<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Preview Kamera Penuh -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Baris Kontrol Atas (Ratio, RAW, Settings) dengan Background Semi-Transparan -->
    <LinearLayout
        android:id="@+id/topProControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="#99000000"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol Pilihan Aspek Rasio Foto -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRatioToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="4:3"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="18dp" />

        <!-- Tombol Toggle Format RAW -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRawToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="RAW"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="18dp" />

        <!-- Tombol Pengaturan -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Panel Kontrol Bawah (Semi-Transparan Modern) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Baris Parameter Pro (EV, ISO, S, WB, MF) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="10dp">

            <Button
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#33FFFFFF"
                android:text="EV"
                android:textSize="10sp"
                android:textColor="@android:color/white" />

            <Button
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#33FFFFFF"
                android:text="ISO"
                android:textSize="10sp"
                android:textColor="@android:color/white" />

            <Button
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#33FFFFFF"
                android:text="S"
                android:textSize="10sp"
                android:textColor="@android:color/white" />

            <Button
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#33FFFFFF"
                android:text="WB"
                android:textSize="10sp"
                android:textColor="@android:color/white" />

            <Button
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#33FFFFFF"
                android:text="MF"
                android:textSize="10sp"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Baris Shutter, Preview Galeri, dan Switch Kamera -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="32dp">

            <!-- Tombol Preview / Thumbnail Foto Terakhir (Kiri Bawah) -->
            <ImageButton
                android:id="@+id/btnGalleryPreview"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/ic_launcher_background"
                android:scaleType="centerCrop"
                android:contentDescription="Galeri Preview"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Tombol Shutter / SNAP Melingkar (Tengah) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapturePro"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:backgroundTint="#FF3B30"
                android:text="SNAP"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="38dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Tombol Switch Kamera Depan/Belakang (Kanan Bawah) -->
            <ImageButton
                android:id="@+id/btnSwitchCamera"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_camera"
                android:scaleType="centerInside"
                app:tint="@android:color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
