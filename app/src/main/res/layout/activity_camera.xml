<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Preview Kamera Penuh -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1. Baris Kontrol Atas: Mode Foto & Standar -->
    <LinearLayout
        android:id="@+id/topPhotoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="#99000000"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlashToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:text="⚡ OFF"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHdrToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:text="HDR: ON"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMacroToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:text="MACRO"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRatioToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:text="4:3"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRawToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="RAW"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- 2. Baris Kontrol Atas: Mode Video (5 Item) -->
    <LinearLayout
        android:id="@+id/topVideoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="#99000000"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoFlash"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="⚡ OFF"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoHdr"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="HDR"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoStabilization"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="STAB: ON"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoResolution"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="1080p 30"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <ImageButton
            android:id="@+id/btnVideoSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- 3. Baris Kontrol Atas: Mode Pro (3 Item) -->
    <LinearLayout
        android:id="@+id/topProControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#99000000"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnProFlash"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvRawIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="RAW"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnProSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Tombol Samping Kanan (Info & Switch Kamera) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Panel Kontrol Bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 5 Parameter Pro (Khusus Mode Pro) -->
        <LinearLayout
            android:id="@+id/proParametersBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnEvParam"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#22FFFFFF"
                android:text="EV\n0"
                android:textSize="9sp"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnIsoParam"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#22FFFFFF"
                android:text="ISO\nAuto"
                android:textSize="9sp"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnShutterParam"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#22FFFFFF"
                android:text="S\nAuto"
                android:textSize="9sp"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnWbParam"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#22FFFFFF"
                android:text="WB\nAuto"
                android:textSize="9sp"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnMfParam"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:backgroundTint="#22FFFFFF"
                android:text="MF\nAuto"
                android:textSize="9sp"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Pemilih Mode Kamera (Foto, Video, Pro) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/modePortrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Portrait"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/modeCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Foto"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Video"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/modePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:text="Pro"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Baris Shutter, Gallery Preview, dan Switch Kamera -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:paddingHorizontal="32dp">

            <ImageButton
                android:id="@+id/btnGalleryPreview"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ic_launcher_background"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapturePro"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:backgroundTint="#FF3B30"
                android:text="SNAP"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
