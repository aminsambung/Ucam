    <!-- Baris Kontrol Atas untuk Mode Foto & Pro -->
    <LinearLayout
        android:id="@+id/topPhotoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="#99000000"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlashToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="⚡ OFF"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHdrToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="HDR: ON"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMacroToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="MACRO"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRatioToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="4:3"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRawToggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="RAW"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Baris Kontrol Atas Khusus Mode Video (5 Item: Flash, HDR, Stabilisasi, Resolusi, Settings) -->
    <LinearLayout
        android:id="@+id/topVideoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:background="#99000000"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 1. Flash Video -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoFlash"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="⚡ OFF"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- 2. HDR Video -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoHdr"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="HDR"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- 3. Stabilisasi Video (Anti-shake) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoStabilization"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="STAB: ON"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- 4. Resolusi & Frame Rate Video (1080p 30fps) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoResolution"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp"
            android:text="1080p 30"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:strokeColor="@android:color/white"
            app:cornerRadius="17dp" />

        <!-- 5. Settings Video -->
        <ImageButton
            android:id="@+id/btnVideoSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>
